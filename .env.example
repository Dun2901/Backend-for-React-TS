# Server
PORT=8081
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:8081

# MongoDB
# Checkout cần MongoDB Atlas hoặc MongoDB local chạy replica set.
MONGODB_URL=

# Redis
# REDIS_URL dùng cho cache; REDIS_QUEUE_URL dùng cho BullMQ.
REDIS_URL=redis://127.0.0.1:6379
REDIS_CACHE_TTL=300000
REDIS_QUEUE_URL=redis://127.0.0.1:6379

# JWT
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRE=1d

JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRE=7d

# Seed dữ liệu mẫu
# Chỉ bật sau khi cấu hình INIT_PASSWORD và nguồn ảnh seed bên dưới.
SHOULD_INIT=false
INIT_PASSWORD=

# Email
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=
MAIL_PASS=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
GOOGLE_REDIRECT_URL=${SERVER_URL}/api/v1/auth/google/redirect

# VNPay Sandbox
VNPAY_TMN_CODE=
VNPAY_SECURE_SECRET=
VNPAY_URL=

VNPAY_RETURN_URL=${CLIENT_URL}/payment/vnpay-return
VNPAY_IPN_URL=${SERVER_URL}/api/v1/payments/vnpay-ipn
VNPAY_TEST_MODE=true

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

CLOUDINARY_ROOT_FOLDER=bookstore
CLOUDINARY_AVATAR_FOLDER=bookstore/avatar
CLOUDINARY_BOOK_FOLDER=bookstore/books
CLOUDINARY_REVIEW_FOLDER=bookstore/reviews

# Thư mục đích trên Cloudinary khi upload ảnh seed local.
CLOUDINARY_FOLDER=bookstore/books

# Nguồn ảnh seed. Có thể dùng thư mục local hoặc URL public.
CLOUDINARY_SEED_IMAGE_ROOT=public/images/book
CLOUDINARY_SEED_BASE_URL=https://res.cloudinary.com/dzqvxuol0/image/upload/bookstore/books

# Chatbot
GEMINI_API_KEY=
