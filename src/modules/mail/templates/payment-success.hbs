<html>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Thanh toán thành công</title>
  </head>

  <body
    style='margin: 0; padding: 0; background-color: #f4f4f4; font-family: Helvetica, Arial, sans-serif;'
  >
    <table
      width='100%'
      cellpadding='0'
      cellspacing='0'
      border='0'
      style='background-color: #f4f4f4; padding: 40px 0;'
    >
      <tr>
        <td align='center'>
          <table
            width='600'
            cellpadding='0'
            cellspacing='0'
            border='0'
            style='max-width: 600px; background-color: #ffffff; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 6px rgba(0,0,0,0.05);'
          >
            <tr>
              <td style='background-color: #16a34a; padding: 30px; text-align: center;'>
                <h1 style='margin: 0; color: #ffffff; font-size: 24px; font-weight: bold;'>
                  Thanh toán thành công
                </h1>
              </td>
            </tr>

            <tr>
              <td style='padding: 40px;'>
                <table
                  width='100%'
                  cellpadding='0'
                  cellspacing='0'
                  border='0'
                  style='margin-bottom: 28px;'
                >
                  <tr>
                    <td align='center'>
                      <div
                        style='width: 78px; height: 78px; border-radius: 50%; background-color: #dcfce7; color: #16a34a; font-size: 42px; line-height: 78px; text-align: center;'
                      >
                        ✓
                      </div>
                    </td>
                  </tr>
                </table>

                <p style='margin: 0 0 18px; color: #333333; font-size: 16px; line-height: 1.5;'>
                  Xin chào
                  <strong>{{name}}</strong>,
                </p>

                <p style='margin: 0 0 24px; color: #333333; font-size: 16px; line-height: 1.5;'>
                  BookStore đã ghi nhận thanh toán VNPay thành công cho đơn hàng của bạn.
                </p>

                <table
                  width='100%'
                  cellpadding='0'
                  cellspacing='0'
                  border='0'
                  style='margin: 24px 0; border: 1px solid #e8f5e9; border-radius: 8px; overflow: hidden;'
                >
                  <tr>
                    <td
                      style='padding: 14px 18px; background-color: #f0fdf4; color: #555555; width: 40%;'
                    >
                      Mã đơn hàng
                    </td>
                    <td style='padding: 14px 18px; color: #222222; font-weight: bold;'>
                      {{orderCode}}
                    </td>
                  </tr>

                  <tr>
                    <td style='padding: 14px 18px; background-color: #f0fdf4; color: #555555;'>
                      Trạng thái thanh toán
                    </td>
                    <td style='padding: 14px 18px; color: #16a34a; font-weight: bold;'>
                      {{paymentStatusLabel}}
                    </td>
                  </tr>

                  <tr>
                    <td style='padding: 14px 18px; background-color: #f0fdf4; color: #555555;'>
                      Phương thức
                    </td>
                    <td style='padding: 14px 18px; color: #222222;'>
                      {{paymentMethodLabel}}
                    </td>
                  </tr>

                  <tr>
                    <td style='padding: 14px 18px; background-color: #f0fdf4; color: #555555;'>
                      Tổng tiền
                    </td>
                    <td style='padding: 14px 18px; color: #ee4d2d; font-weight: bold;'>
                      {{totalPriceText}}
                    </td>
                  </tr>
                </table>

                {{#if orderUrl}}
                  <table width='100%' cellpadding='0' cellspacing='0' border='0'>
                    <tr>
                      <td align='center'>
                        <a
                          href='{{orderUrl}}'
                          target='_blank'
                          style='display: inline-block; background-color: #16a34a; color: #ffffff; padding: 13px 24px; border-radius: 6px; text-decoration: none; font-weight: bold;'
                        >
                          Xem chi tiết đơn hàng
                        </a>
                      </td>
                    </tr>
                  </table>
                {{/if}}

                <p style='margin: 30px 0 0; color: #333333; font-size: 16px; line-height: 1.5;'>
                  Trân trọng,<br />
                  BookStore
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>