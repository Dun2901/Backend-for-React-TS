<html>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Cập nhật trạng thái đơn hàng</title>
  </head>

  <body
    style='margin: 0; padding: 0; background-color: #f4f4f4; font-family: Helvetica, Arial, sans-serif;'
  >
    <table
      width='100%'
      cellpadding='0'
      cellspacing='0'
      border='0'
      style='background-color: #f4f4f4; padding: 40px 0;'
    >
      <tr>
        <td align='center'>
          <table
            width='600'
            cellpadding='0'
            cellspacing='0'
            border='0'
            style='max-width: 600px; background-color: #ffffff; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 6px rgba(0,0,0,0.05);'
          >
            <tr>
              <td style='background-color: #0754ad; padding: 30px; text-align: center;'>
                <h1 style='margin: 0; color: #ffffff; font-size: 24px; font-weight: bold;'>
                  Cập nhật đơn hàng
                </h1>
              </td>
            </tr>

            <tr>
              <td style='padding: 40px;'>
                <p style='margin: 0 0 18px; color: #333333; font-size: 16px; line-height: 1.5;'>
                  Xin chào
                  <strong>{{name}}</strong>,
                </p>

                <p style='margin: 0 0 24px; color: #333333; font-size: 16px; line-height: 1.5;'>
                  Đơn hàng của bạn vừa được cập nhật trạng thái.
                </p>

                <table
                  width='100%'
                  cellpadding='0'
                  cellspacing='0'
                  border='0'
                  style='margin: 24px 0; border: 1px solid #e8eef7; border-radius: 8px; overflow: hidden;'
                >
                  <tr>
                    <td
                      style='padding: 14px 18px; background-color: #f7fbff; color: #555555; width: 40%;'
                    >
                      Mã đơn hàng
                    </td>
                    <td style='padding: 14px 18px; color: #222222; font-weight: bold;'>
                      {{orderCode}}
                    </td>
                  </tr>

                  <tr>
                    <td style='padding: 14px 18px; background-color: #f7fbff; color: #555555;'>
                      Trạng thái mới
                    </td>
                    <td style='padding: 14px 18px; color: #0754ad; font-weight: bold;'>
                      {{statusLabel}}
                    </td>
                  </tr>

                  <tr>
                    <td style='padding: 14px 18px; background-color: #f7fbff; color: #555555;'>
                      Thanh toán
                    </td>
                    <td style='padding: 14px 18px; color: #222222;'>
                      {{paymentMethodLabel}}
                      -
                      {{paymentStatusLabel}}
                    </td>
                  </tr>

                  <tr>
                    <td style='padding: 14px 18px; background-color: #f7fbff; color: #555555;'>
                      Tổng tiền
                    </td>
                    <td style='padding: 14px 18px; color: #ee4d2d; font-weight: bold;'>
                      {{totalPriceText}}
                    </td>
                  </tr>
                </table>

                {{#if items}}
                  <table
                    width='100%'
                    cellpadding='0'
                    cellspacing='0'
                    border='0'
                    style='margin-bottom: 24px; border-collapse: collapse;'
                  >
                    <tr>
                      <th
                        align='left'
                        style='padding: 10px; border-bottom: 1px solid #eeeeee; color: #555555;'
                      >
                        Sản phẩm
                      </th>
                      <th
                        align='center'
                        style='padding: 10px; border-bottom: 1px solid #eeeeee; color: #555555;'
                      >
                        SL
                      </th>
                      <th
                        align='right'
                        style='padding: 10px; border-bottom: 1px solid #eeeeee; color: #555555;'
                      >
                        Thành tiền
                      </th>
                    </tr>

                    {{#each items}}
                      <tr>
                        <td
                          style='padding: 10px; border-bottom: 1px solid #f3f3f3; color: #333333;'
                        >
                          {{bookName}}
                        </td>
                        <td
                          align='center'
                          style='padding: 10px; border-bottom: 1px solid #f3f3f3; color: #333333;'
                        >
                          {{quantity}}
                        </td>
                        <td
                          align='right'
                          style='padding: 10px; border-bottom: 1px solid #f3f3f3; color: #333333;'
                        >
                          {{subtotalText}}
                        </td>
                      </tr>
                    {{/each}}
                  </table>
                {{/if}}

                {{#if orderUrl}}
                  <table width='100%' cellpadding='0' cellspacing='0' border='0'>
                    <tr>
                      <td align='center'>
                        <a
                          href='{{orderUrl}}'
                          target='_blank'
                          style='display: inline-block; background-color: #0754ad; color: #ffffff; padding: 13px 24px; border-radius: 6px; text-decoration: none; font-weight: bold;'
                        >
                          Xem chi tiết đơn hàng
                        </a>
                      </td>
                    </tr>
                  </table>
                {{/if}}

                <p style='margin: 30px 0 0; color: #333333; font-size: 16px; line-height: 1.5;'>
                  Trân trọng,<br />
                  BookStore
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>